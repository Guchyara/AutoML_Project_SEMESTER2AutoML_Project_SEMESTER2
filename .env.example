# Data source mode: kaggle, local or auto
TITANIC_DATA_SOURCE=kaggle

# Kaggle sources. The loader tries the dataset first and the competition as fallback.
KAGGLE_DATASET=heptapod/titanic
KAGGLE_COMPETITION=titanic

# Used by local/auto mode when no train.csv and test.csv pair exists.
TITANIC_LOCAL_DATA_PATH=/opt/airflow/data/raw/train_and_test2.csv
TITANIC_LOCAL_TRAIN_ROWS=891

# Model comparison settings.
MODEL_EXPERIMENT_NAME=titanic_model_comparison
REGISTERED_MODEL_NAME=titanic-survival-predictor

# Airflow tasks use this service name inside the Compose network.
MLFLOW_TRACKING_URI=http://mlflow:5000

# Dynamic multi-dataset pipeline (Assignment 3).
# Airflow Variable dynamic_datasets controls the selected JSON list, for example:
# ["titanic", "iris"]
DYNAMIC_DATA_SOURCE=auto
DYNAMIC_ALLOW_BUILTIN_FALLBACK=true
DYNAMIC_EXPERIMENT_PREFIX=dynamic_ml_pipeline
DYNAMIC_REGISTERED_MODEL_PREFIX=dynamic

# Inference service for Assignment 4.
INFERENCE_MODEL_NAME=titanic-survival-predictor
INFERENCE_MODEL_STAGE=Production
INFERENCE_EXPERIMENT_NAME=mlops_inference
INFERENCE_API_URL=http://inference-api:8000

